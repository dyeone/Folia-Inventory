{
  "manifest_version": 3,
  "name": "Folia Label Helper",
  "version": "0.3.0",
  "description": "Drive Palmstreet's USPS label flow from a Folia work queue. Reads weight from a USB scale, captures label + slip PDFs, syncs tracking back.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.palmstreet.app/*",
    "https://*.palmstreet.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Folia Label Helper"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.palmstreet.app/*",
        "https://*.palmstreet.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
