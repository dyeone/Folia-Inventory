# Supabase — copy this file to .env.local and fill in your values.
# Find these in: Supabase Dashboard → Project Settings → API
#
# SERVICE ROLE KEY IS SECRET. It's only used by server-side API routes
# (files under /api) and is never exposed to the browser.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# OPTIONAL — enables Supabase Realtime for the packer's iPad→phone
# "Send to phone" handoff (instant instead of ~2.5s polling). These are
# EXPOSED to the browser (VITE_ prefix), which is safe: every table has RLS
# enabled with no anon policies, so the anon key grants no table access, and
# the feature uses broadcast channels only (no DB rows). Without these, the
# handoff still works via polling. The URL is the same as SUPABASE_URL above;
# the anon key is the "anon public" key from Dashboard → Project Settings → API.
# Set them as build-time vars in Vercel (Production + Preview) too.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ShipStation (server-side only, never bundled to the browser).
# Generate at ShipStation → Settings → Account → API Settings.
SHIPSTATION_API_KEY=your-shipstation-api-key
SHIPSTATION_API_SECRET=your-shipstation-api-secret

# Shippo (server-side only). Quotes rates alongside ShipStation in the
# Shipping tab's per-box rate comparison. A "test" token (shippo_test_*)
# returns sandbox rates without charging; a "live" token (shippo_live_*)
# returns real rates. Find it in Shippo → Settings → API.
SHIPPO_API_TOKEN=your-shippo-api-token
